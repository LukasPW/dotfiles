// Generated by matugen — do not edit by hand.
// Template source: ~/.config/matugen/templates/niri-colors.kdl
// Rendered to: ~/.config/niri/colors.kdl
// Included from config.kdl via: include "colors.kdl"

layout {
    focus-ring {
        // Mirrors Hyprland's active_border gradient (primary -> tertiary, 45deg)
        active-gradient from="#90cef4" to="#cbc1e9" angle=45

        // Mirrors Hyprland's inactive_border: surface at alpha 0x99
        inactive-color "#0f141799"
    }

    border {
        // If you ever flip on `border` instead of `focus-ring`, same gradient applies here
        active-gradient from="#90cef4" to="#cbc1e9" angle=45
        inactive-color "#0f141799"
        urgent-color "#ffb4ab"
    }

    shadow {
        // Mirrors Hyprland's shadow color: background at alpha 0x88
        color "#0f141788"
    }
}
