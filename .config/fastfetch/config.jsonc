{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": " ",
    "key": { "width": 0 },
    "percent": { "type": 3 }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "{#keys}╭─ software ──────────────────────" },
    { "type": "os",       "key": "{#keys}│ \uf30d os      " },
    { "type": "kernel",   "key": "{#keys}│ \uf17c kernel  " },
    { "type": "packages", "key": "{#keys}│ \uf187 pkgs    " },
    { "type": "shell",    "key": "{#keys}│ \uf120 shell   " },
    { "type": "wm",       "key": "{#keys}│ \uf2d0 wm      " },
    { "type": "terminal", "key": "{#keys}│ \ue795 term    " },
    { "type": "custom", "format": "{#keys}├─ hardware ──────────────────────" },
    { "type": "cpu",      "key": "{#keys}│ \uf4bc cpu     " },
    { "type": "gpu",      "key": "{#keys}│ \uf26c gpu     " },
    { "type": "memory",   "key": "{#keys}│ \uefc5 memory  " },
    { "type": "disk",     "key": "{#keys}│ \uf0a0 disk    " },
    { "type": "uptime",   "key": "{#keys}│ \uf017 uptime  " },
    { "type": "custom", "format": "{#keys}╰─────────────────────────────────" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
